rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation definitions
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 256
        && data.isPremium is bool;
    }

    function isValidUsage(data) {
      return data.userId == request.auth.uid
        && data.date is string
        && data.date.size() <= 32
        && data.count is int
        && data.count >= 0
        && data.count <= 10;
    }

    function isValidOpportunity(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.userId == request.auth.uid
        && data.inputPrompt is string
        && data.inputPrompt.size() <= 1000
        && data.title is string
        && data.title.size() <= 200
        && data.problem is string
        && data.problem.size() <= 2000
        && data.solution is string
        && data.solution.size() <= 2000
        && data.targetUsers is list
        && data.features is list
        && data.monetization is list
        && data.feasibilityScore is int
        && data.feasibilityScore >= 1
        && data.feasibilityScore <= 10
        && data.executionDifficulty is string
        && data.opportunities is list
        && data.risks is list
        && data.skepticFeedback is string
        && data.skepticFeedback.size() <= 4000
        && data.isSaved is bool;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId)
                    && isValidUser(request.resource.data)
                    && request.resource.data.email == resource.data.email;
      allow delete: if false; // Users cannot be deleted from Client SDK

      // DailyUsage Subcollection
      match /dailyUsage/{dateId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // OPPORTUNITIES COLLECTION
    match /opportunities/{opportunityId} {
      // Allow single document fetching if signed in and are owner
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Query Enforcer: Require client queries to explicitly filter by userId
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() 
                    && isValidId(opportunityId) 
                    && isValidOpportunity(request.resource.data);

      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && isValidOpportunity(request.resource.data);

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
